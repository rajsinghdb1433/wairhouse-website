# Copy to .env (local) or set these in your hosting panel's environment variables. NEVER commit real values.
NODE_ENV=production
PORT=3000
SITE_URL=https://www.your-domain.com.au          # exact public address, https. Used for cookies, emails and security checks
TRUST_PROXY=1                                    # 1 when behind Hostinger/Cloudflare/nginx

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# First admin account (created on first start only). If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=raj_softdev@hotmail.com
ADMIN_NAME=Raj Singh
ADMIN_PASSWORD=

# Email. The easiest way is NOT here: sign in as admin and open Admin > Email (the password is stored encrypted).
# These are only a fallback when nothing is saved there.
# Personal Hotmail/Outlook.com/Live addresses can no longer send mail through SMTP (Microsoft turned off password and app-password sign-in),
# so send from a mailbox on your own domain (Hostinger Email shown below) and keep Hotmail as the Reply-To so replies reach your inbox.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                                       # e.g. hello@your-domain.com.au
SMTP_PASS=
MAIL_FROM=                                       # defaults to SMTP_USER. Must be the mailbox's own address
MAIL_FROM_NAME=wAIRhouse
MAIL_REPLY_TO=raj_softdev@hotmail.com

# Optional: stronger human check than the built-in image captcha (free at dash.cloudflare.com > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: card payments (dashboard.stripe.com > Developers). Then switch on "Card payments" in Admin > Site settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                           # webhook endpoint: https://your-domain/api/stripe/webhook, event: checkout.session.completed

# Show sample listings on a fresh database (set false for a clean launch)
SEED_DEMO=true
